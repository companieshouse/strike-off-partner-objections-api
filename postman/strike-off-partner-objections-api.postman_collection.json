{
  "info": {
    "name": "Strike Off Partner Objections API",
    "description": "Basic collection for local testing of healthcheck and create objection endpoints.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_postman_id": "8f8a8a1b-2c9a-4c69-9e8d-7a7f6b0d1b1a"
  },
  "item": [
    {
      "name": "Healthcheck",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Host",
            "value": "{{hostHeader}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/strike-off-partner-objections-api/healthcheck",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "strike-off-partner-objections-api",
            "healthcheck"
          ]
        }
      },
      "response": []
    },
    {
      "name": "Create Objection",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Host",
            "value": "{{hostHeader}}",
            "type": "text"
          },
          {
            "key": "X-Request-Id",
            "value": "test-request-001",
            "type": "text"
          },
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"submission_company_name\": \"ACME LTD\",\n  \"partner_case_reference\": \"CASE-123\",\n  \"partner_objection_workstream\": \"DS01\",\n  \"partner_contact_email\": \"case.owner@example.com\",\n  \"partner_objection_reason\": \"Evidence supplied by partner\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/strike-off-partner-objections-api/company/{{companyNumber}}/strike-off-partner-objections",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "strike-off-partner-objections-api",
            "company",
            "{{companyNumber}}",
            "strike-off-partner-objections"
          ]
        }
      },
      "response": []
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost"
    },
    {
      "key": "hostHeader",
      "value": "api.chs.local"
    },
    {
      "key": "companyNumber",
      "value": "12345678"
    }
  ]
}

