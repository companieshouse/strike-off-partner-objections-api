    {
      "name": "Create Objection",
      "item": [
        {
          "name": "201 - Create Objection (Happy Path)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"returns 201 for valid create objection\", function () {",
                  "  pm.response.to.have.status(201);",
                  "});",
                  "pm.test(\"stores objection_id for follow-up GET\", function () {",
                  "  var body = pm.response.json();",
                  "  var objectionId = body.objection_id || body.objectionId;",
                  "  pm.expect(objectionId).to.exist;",
                  "  pm.collectionVariables.set(\"objection_id\", objectionId);",
                  "  pm.collectionVariables.set(\"objectionId\", objectionId);",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Host",
                "value": "{{hostHeader}}",
                "type": "text"
              },
              {
